    {
      "id": 6,
      "type": "stat",
      "title": "キャッシュ読み込み率",
      "description": "入力 token のうちキャッシュから読んだ割合。cache_read / (input + cache_read + cache_creation)。",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | vcs_repository_name=~\"$repo\" | unwrap cache_read_tokens [$__range])) / (sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | vcs_repository_name=~\"$repo\" | unwrap input_tokens [$__range])) + sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | vcs_repository_name=~\"$repo\" | unwrap cache_read_tokens [$__range])) + sum(sum_over_time({service_name=\"claude-code\"} | event_name=\"api_request\" | vcs_repository_name=~\"$repo\" | unwrap cache_creation_tokens [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "API エラー",
